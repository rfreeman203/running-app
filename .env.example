# Postgres connection string (Neon/Supabase pooled URL, includes ?sslmode=require)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
GOOGLE_CLIENT_ID=your_google_web_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Same value as GOOGLE_CLIENT_ID; Vite exposes only VITE_-prefixed vars to the browser.
# Must be present at BUILD time (baked into the bundle), not just at runtime.
VITE_GOOGLE_CLIENT_ID=your_google_web_client_id
JWT_SECRET=a_long_random_secret_string
# In production (single service) set both to the one app URL, e.g. https://your-app.onrender.com
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
ANTHROPIC_API_KEY=your_anthropic_api_key
